# Copia este archivo como .env y rellénalo. .env NUNCA se sube a GitHub.

# Clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Clave gratuita en https://www.pexels.com/api/ (para el botón «Buscar foto en internet»)
PEXELS_API_KEY=

# Opcional: modelo de Gemini (por defecto, el último Flash)
# GEMINI_MODEL=gemini-flash-latest

# Opcional en local; obligatorio en Vercel si usas Supabase:
# hace que solo tú (con sesión iniciada) puedas usar la IA.
SUPABASE_URL=
SUPABASE_ANON_KEY=
